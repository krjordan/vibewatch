{
	"name": "vibewatch",
	"version": "0.1.1",
	"description": "Your AI pair programmer's eyes on your terminal. Live terminal monitoring for Claude via MCP.",
	"type": "module",
	"author": "Ryan Jordan",
	"license": "MIT",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"claude",
		"ai",
		"terminal",
		"cli",
		"debugging",
		"error-monitoring",
		"developer-tools",
		"nextjs",
		"vite",
		"python",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/krjordan/vibewatch.git"
	},
	"bugs": {
		"url": "https://github.com/krjordan/vibewatch/issues"
	},
	"homepage": "https://github.com/krjordan/vibewatch#readme",
	"bin": {
		"vibewatch": "./dist/cli.js",
		"vibewatch-mcp": "./dist/mcp-server.js"
	},
	"files": [
		"dist/**/*",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"prepublishOnly": "npm run clean && npm run build && npm run test"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.0.0",
		"commander": "^12.0.0",
		"fastify": "^5.0.0",
		"strip-ansi": "^7.1.0",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@vitest/coverage-v8": "^4.0.15",
		"tsup": "^8.0.0",
		"typescript": "^5.6.0",
		"vitest": "^4.0.15"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
